{
  // Configuração do Calendário de Conteúdo na Cloudflare
  "name": "calendario-conteudo",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calendário-db",
      "database_id": "05a54d75-77be-41da-a990-57098f834611"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MIDIAS",
      "bucket_name": "calendario-midias"
    }
  ]
}
